# Voorbeeld-instellingen. Kopieer naar .env.local en vul aan.
# .env.local staat in .gitignore en hoort daar ook te blijven.

# ------------------------------------------------------------------
# Firebase — browserkant
# Deze sleutels zijn publiek (ze staan in de paginabron). De beveiliging zit
# in firestore.rules en storage.rules, niet in geheimhouding hiervan.
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=metmekaere.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=metmekaere
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=metmekaere.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# Firebase — serverkant
# Lokaal heb je één van deze twee nodig (of je draait tegen de emulator,
# zie onderaan). Op App Hosting is niets nodig: daar wordt de service account
# van Cloud Run gebruikt.
# ------------------------------------------------------------------
FIREBASE_PROJECT_ID=metmekaere
# GOOGLE_APPLICATION_CREDENTIALS=C:/pad/naar/serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# ------------------------------------------------------------------
# Het webadres van de site
# Bepaalt canonieke links, de sitemap en hoe de site eruitziet bij delen.
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Betalen (Mollie)
# Leeg laten = lokaal een nagebootste betaalpagina, zodat je het hele
# bestelproces kunt testen zonder account. In productie weigert de checkout
# dan met een nette melding; er kan nooit per ongeluk gratis besteld worden.
# Een test-sleutel begint met test_, een live-sleutel met live_.
# ------------------------------------------------------------------
# MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# Bevestigingsmails (SMTP)
# Zonder deze instellingen wordt een mail in het log gezet in plaats van
# verstuurd. Een bestelling loopt daar niet op vast.
# ------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=hallo@metmekaere.nl

# ------------------------------------------------------------------
# Nieuwsbrief
# 'none' = inschrijvingen alleen in Firestore. Verder: 'mailerlite' of 'laposta'.
# ------------------------------------------------------------------
NEWSLETTER_PROVIDER=none
# MAILERLITE_API_KEY=
# MAILERLITE_GROUP_ID=
# LAPOSTA_API_KEY=
# LAPOSTA_LIST_ID=

# ------------------------------------------------------------------
# Lokaal ontwikkelen met de Firebase-emulator (npm run emulators)
# Zet deze regels uit om tegen het echte project te werken.
# ------------------------------------------------------------------
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1

NEXT_TELEMETRY_DISABLED=1
